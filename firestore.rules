rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Funções auxiliares de validação de dados
    function temCamposObrigatorios(campos) {
      return request.resource.data.keys().hasAll(campos);
    }

    // 1. Supermercados cadastrados
    match /supermercados/{lojaId} {
      allow read: if true;
      allow create, update: if request.resource.data.id == lojaId &&
                               request.resource.data.nome is string &&
                               request.resource.data.nome.size() > 0;
      allow delete: if true;
    }

    // 2. Credenciais Master do Dono do Aplicativo
    match /usuarios_master/{docId} {
      allow read, write: if true;
    }

    // 3. Catálogo Global de Produtos (Referência de imagens e código de barras)
    match /catalogo_global/{codigoBarra} {
      allow read: if true;
      allow create, update: if request.resource.data.codigo is string &&
                               request.resource.data.nome is string;
      allow delete: if false; // Previne deleção acidental da base mestra de códigos
    }

    // 4. Estoque por Supermercado
    match /{path=**}/estoque_{lojaId}/{itemId} {
      allow read: if true;
      allow write: if request.resource.data.codigo is string &&
                      request.resource.data.quantidade is number;
    }

    // 5. Vendas por Supermercado (Imutáveis após registro)
    match /{path=**}/vendas_{lojaId}/{vendaId} {
      allow read: if true;
      allow create: if request.resource.data.id is string &&
                       request.resource.data.valorTotal is number;
      allow update: if request.resource.data.status in ['concluida', 'estornada'];
      allow delete: if false; // Proibido deletar histórico fiscal/contábil de vendas
    }

    // 6. Operadores e Caixas por Supermercado
    match /{path=**}/operadores_{lojaId}/{opId} {
      allow read, write: if true;
    }

    // 7. Clientes Devedores (Caderneta Fiado) por Loja
    match /{path=**}/clientes_devedores_{lojaId}/{clienteId} {
      allow read, write: if true;
    }

    // 8. Termos de Concordância e Sigilo do Usuário
    match /termos_concordancia/{termoId} {
      allow read: if true;
      allow create: if request.resource.data.usuarioId is string &&
                       request.resource.data.aceitou == true;
      allow update, delete: if false; // Termo aceito é inviolável e permanente
    }

    // 9. Logs de Auditoria do Sistema
    match /logs_auditoria/{logId} {
      allow read: if true;
      allow create: if request.resource.data.acao is string;
      allow update, delete: if false; // Logs são estritamente append-only
    }

    // Fallback de segurança para demais coleções
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

